# agdash: read-only dashboard for one AGR campaign.
# Serves the campaign's dashboard.html (generated by the loop's dashboard.py)
# plus JSON endpoints derived from the shared volume. No build step needed.
FROM python:3.13-slim

COPY server.py /opt/agr/server.py
WORKDIR /opt/agr

EXPOSE 8080
CMD ["python3", "/opt/agr/server.py"]
